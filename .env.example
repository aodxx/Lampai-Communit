# Server-side only. NEVER commit real values or put the service-role key in client code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Admin PWA: ใช้ true เฉพาะ local development; production ต้องใช้ Supabase credentials
ADMIN_DEMO=false
COMMUNITY_ID=11111111-1111-4111-8111-111111111111
MANUAL_SOURCE_ID=22222222-2222-4222-8222-222222222222
LINE_CHANNEL_ACCESS_TOKEN=
# broadcast | <groupId or userId>   (see PRD open question #1)
LINE_TARGET=broadcast
# healthcheck: userId/groupId ของ "ผู้ดูแล" เท่านั้น (ห้าม broadcast ห้ามใช้กลุ่มชุมชน)
ADMIN_LINE_TARGET=
# เว้นว่าง = ตรวจครบ (weather,scheduler,dispatch,briefing); ใช้ลดรายการบน staging
HEALTH_EXPECTED_JOBS=
# โควต้า LINE อ่านจาก API ด้วย LINE_CHANNEL_ACCESS_TOKEN (เกณฑ์ 80%/95% อยู่ใน src/engine/quota.ts)

# ตัวตั้งเวลาภายนอก (POST /api/cron/tick) — สุ่มยาว >= 16 ตัวอักษร; ไม่ตั้ง = endpoint ปิด
CRON_SECRET=
